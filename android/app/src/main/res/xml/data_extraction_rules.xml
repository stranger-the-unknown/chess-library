<?xml version="1.0" encoding="utf-8"?>
<!--
  Uygulama verisi buluta yedeklenmiyor ve yeni telefona aktarılmıyor.

  Android'in otomatik yedeklemesi açıkken uygulamayı silmek veriyi
  silmiyordu: yeniden kurulunca listeler, ayarlar ve analizler Drive'dan
  geri geliyordu. Kullanıcının "sıfırdan başlama" yolu buydu ve
  çalışmıyordu. Yedek almak isteyen Ayarlar -> Veri altındaki dosyaya
  yazan yedeklemeyi kullanıyor; o yedek kullanıcının elinde duruyor.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
