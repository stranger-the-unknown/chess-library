<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ekran kaydı (10.10.0): ekran yansıtma türünde ön plan hizmeti.
         Videonun sesi uygulamanın kendi seslerinden üretiliyor; ses kaydı
         izni 10.10.1'den beri yok. Bkz. RecordService.kt, Mp4Writer.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Kayıt bildirimi ("Durdur") Android 13+ sürümlerinde yalnızca bu
         izin verilmişse görünüyor. İlk kayıttan önce bir kez soruluyor
         (ChessActivity.shouldAskForNotifications, 10.14.0). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:extractNativeLibs="true"
        android:label="Chess Library"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Android 16, API 36'yı hedefleyen uygulamalarda en kısa kenarı
             600 dp ve üstü olan ekranlarda (tabletler) yönelim kilidini yok
             sayıyor. Uygulama telefonu dikeye, tableti yataya kilitliyor
             (lib/main.dart, _lockOrientation); bu özellik olmadan tablet
             dönüyor ve yerleşim istenmeyen düzene düşüyordu. Yalnızca
             targetSdk 36 iken geçerli: build.gradle.kts'teki notlara bakın. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <!-- Uygulamanın tek etkinliği. Başlatıcıdan doğrudan değil, aşağıdaki
             girdilerden (activity-alias) biriyle açılıyor. -->
        <activity
            android:name=".ChessActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <!-- Başlatıcı girdileri: her görünümün (Ayarlar → Renk ve simge) kendi
             simgesiyle bir girdisi var; yalnızca biri açık. Simgeyi AppIcon.kt
             değiştiriyor; simgeleri tools/make_look_icons.py üretiyor.

             Varsayılan girdi etkinliğin eski adını (.MainActivity) taşıyor:
             ana ekrandaki kısayollar bu adı sakladığı için güncellemeden
             sonra da çalışıyorlar.

             NormalTheme her girdide yineleniyor: Flutter bu bilgiyi
             açılırken kullanılan girdiden okuyor, etkinlikten değil. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGece"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_gece">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGok"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_gok">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPetrol"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_petrol">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMor"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_mor">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBordo"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_bordo">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMercan"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_mercan">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAltin"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_altin">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconKahve"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_kahve">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAntrasit"
            android:targetActivity=".ChessActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_look_antrasit">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
